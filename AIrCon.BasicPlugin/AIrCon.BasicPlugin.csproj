<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <RootNamespace>AIrCon.BasicPlugin</RootNamespace>
    <AssemblyName>AIrCon.BasicPlugin</AssemblyName>
    <Version>1.0.10</Version>
    <FileVersion>1.0.10.0</FileVersion>
    <AssemblyVersion>1.0.10.0</AssemblyVersion>
    <InformationalVersion>1.0.10</InformationalVersion>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    Developer Diagnostics canonical build boundary.
    - Normal development builds default to diagnostics ON.
    - An explicitly requested public build must pass:
        /p:TvAIrPublicRelease=true /p:TvAIrDeveloperDiagnostics=false
    - Diagnostic-only logging, measurement and permissions must stay behind
      AIRCON_DEVELOPER_DIAGNOSTICS so OFF builds do not execute diagnostic work.
    - Product behavior must not depend on this boundary.
    Keep this as the single Developer Diagnostics authority; do not add parallel flags.
  -->
  <PropertyGroup>
    <DefineConstants Condition="'$(TvAIrDeveloperDiagnostics)' == 'true'">$(DefineConstants);AIRCON_DEVELOPER_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="AIrCon.ico">
      <LogicalName>AIrCon.ico</LogicalName>
    </EmbeddedResource>
    <Content Include="AIrCon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TvAIrPlugin\TvAIrPlugin.csproj" Private="false" />
  </ItemGroup>

  <!-- Developer-only analysis input: never built when Diagnostics is OFF. -->
  <Target Name="BuildAIrConScopedLogExtractor" AfterTargets="Build"
          Condition="'$(TvAIrDeveloperDiagnostics)' == 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../AIrCon.DevLogScope/AIrCon.DevLogScope.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);TvAIrDeveloperDiagnostics=$(TvAIrDeveloperDiagnostics);TvAIrPublicRelease=$(TvAIrPublicRelease)" />
  </Target>
</Project>
