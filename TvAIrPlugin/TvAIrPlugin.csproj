<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TvAIrPlugin</RootNamespace>
    <AssemblyName>TvAIrPlugin</AssemblyName>
    <Version>1.0.4</Version>
    <FileVersion>0.11.315.0</FileVersion>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <InformationalVersion>0.11.315-plugin-host-contract-foundation</InformationalVersion>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <Target Name="EnsureRestoreAssets" BeforeTargets="PrepareForBuild" Condition="!Exists('$(ProjectAssetsFile)')">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore" Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>
</Project>
