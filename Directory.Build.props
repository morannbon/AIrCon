<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <TvAIrProductVersion>1.2.14</TvAIrProductVersion>
    <TvAIrFileVersion>1.2.14.0</TvAIrFileVersion>
    <TvAIrAssemblyVersion>1.2.14.0</TvAIrAssemblyVersion>
    <TvAIrPluginSdkVersion>1.1.18</TvAIrPluginSdkVersion>
    <TvAIrPluginSdkAssemblyVersion>1.0.0.0</TvAIrPluginSdkAssemblyVersion>
    <TvAIrPluginHostContractVersion>1.1.18</TvAIrPluginHostContractVersion>
    <TvAIrPublicContractName>release_contract</TvAIrPublicContractName>
    <TvAIrPluginHostContractName>plugin-host-foundation</TvAIrPluginHostContractName>
    <TvAIrPluginCompatibilityMajor>1</TvAIrPluginCompatibilityMajor>
    <TvAIrMinimumSupportedPluginHostContractVersion>1.0.0</TvAIrMinimumSupportedPluginHostContractVersion>
    <!-- Single Developer Diagnostics authority for SDK, AIrCon and developer-only tools. -->
    <TvAIrDeveloperDiagnostics Condition="'$(TvAIrDeveloperDiagnostics)' == ''">true</TvAIrDeveloperDiagnostics>
    <DefineConstants Condition="'$(TvAIrDeveloperDiagnostics)' == 'true'">$(DefineConstants);TVAIR_DEVELOPER_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <!-- Never silently accept a legacy property that can diverge from the canonical gate. -->
  <Target Name="ValidateDeveloperDiagnosticsBoundary" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AIrConDeveloperDiagnostics)' != ''"
           Text="AIrConDeveloperDiagnostics is obsolete. Use TvAIrDeveloperDiagnostics as the single build gate." />
    <Error Condition="'$(TvAIrPublicRelease)' == 'true' and '$(TvAIrDeveloperDiagnostics)' != 'false'"
           Text="Public release requires TvAIrDeveloperDiagnostics=false." />
  </Target>
</Project>